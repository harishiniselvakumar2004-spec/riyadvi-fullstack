# ── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma separated list of allowed frontend origins
CLIENT_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# ── PostgreSQL ───────────────────────────────────────
# Local (docker compose up -d) or Neon / Render / Railway connection string
DATABASE_URL=postgres://riyadvi:riyadvi@localhost:5432/riyadvi
# Set to true for hosted databases that require SSL (Neon, Render, Railway)
DATABASE_SSL=false

# ── Admin dashboard ──────────────────────────────────
ADMIN_EMAIL=admin@riyadvi.com
ADMIN_PASSWORD=ChangeMe@123
JWT_SECRET=replace-with-a-long-random-string

# ── Email notifications (optional – logs to console when empty) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Riyadvi Website <no-reply@riyadvi.com>"
NOTIFY_EMAIL=hello@riyadvi.com

# ── Public links surfaced to the frontend via /api/config ──
WHATSAPP_NUMBER=919999999999
CALENDLY_URL=https://calendly.com/your-handle/30min
